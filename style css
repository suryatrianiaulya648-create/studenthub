   Struktur:
    1. Reset & Base
    2. Variables (Design Tokens)
    3. Typography
    4. Layout Utilities
    5. Navbar
    6. Buttons
    7. Hero Section
    8. Section Shared
    9. Feature Cards
   10. Schedule Table
   11. Task List
   12. Tips Cards
   13. About Section
   14. Contact Section
   15. Footer
   16. Back To Top
   17. Animations & Reveal
   18. Responsive
   ============================================================ */

/* ============================================================
   1. RESET & BASE
   ============================================================ */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  font-family: 'Poppins', sans-serif;
  background: #f8faff;
  color: #1e293b;
  line-height: 1.6;
  overflow-x: hidden;
}

img, svg { display: block; max-width: 100%; }

a { text-decoration: none; color: inherit; }

ul { list-style: none; }

/* ============================================================
   2. DESIGN TOKENS
   ============================================================ */
:root {
  /* Colors */
  --navy:        #0f172a;
  --navy-800:    #1e293b;
  --navy-700:    #334155;
  --blue-600:    #2563eb;
  --blue-500:    #3b82f6;
  --blue-400:    #60a5fa;
  --blue-100:    #dbeafe;
  --blue-50:     #eff6ff;
  --purple-600:  #7c3aed;
  --purple-500:  #8b5cf6;
  --purple-100:  #ede9fe;
  --teal-500:    #14b8a6;
  --orange-500:  #f97316;
  --white:       #ffffff;
  --gray-50:     #f8fafc;
  --gray-100:    #f1f5f9;
  --gray-200:    #e2e8f0;
  --gray-400:    #94a3b8;
  --gray-500:    #64748b;
  --gray-600:    #475569;
  --green-500:   #22c55e;
  --green-100:   #dcfce7;
  --yellow-500:  #f59e0b;
  --yellow-100:  #fef3c7;
  --red-500:     #ef4444;
  --red-100:     #fee2e2;

  /* Gradients */
  --gradient-primary: linear-gradient(135deg, var(--blue-600) 0%, var(--purple-600) 100%);
  --gradient-hero:    linear-gradient(160deg, #0f172a 0%, #1e3a8a 50%, #312e81 100%);
  --gradient-soft:    linear-gradient(135deg, #eff6ff 0%, #ede9fe 100%);

  /* Shadows */
  --shadow-sm:  0 1px 3px rgba(0,0,0,.08);
  --shadow-md:  0 4px 16px rgba(15,23,42,.10);
  --shadow-lg:  0 8px 32px rgba(15,23,42,.14);
  --shadow-xl:  0 16px 48px rgba(15,23,42,.18);

  /* Radius */
  --radius-sm:  0.5rem;
  --radius-md:  1rem;
  --radius-lg:  1.5rem;
  --radius-xl:  2rem;
  --radius-full: 9999px;

  /* Transitions */
  --transition: all 0.3s ease;
  --transition-fast: all 0.2s ease;
}

/* ============================================================
   3. TYPOGRAPHY
   ============================================================ */
.gradient-text {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ============================================================
   4. LAYOUT
   ============================================================ */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* ============================================================
   5. NAVBAR
   ============================================================ */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,.06);
  transition: var(--transition);
}

/* Scrolled state: lighter background, shadow */
.navbar.scrolled {
  background: rgba(15, 23, 42, 0.97);
  box-shadow: 0 2px 20px rgba(0,0,0,.25);
}

.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  height: 68px;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--white);
  flex-shrink: 0;
}

.logo-icon { font-size: 1.4rem; }

.logo-accent {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-links {
  display: flex;
  gap: 0.25rem;
  margin: 0 auto;
}

.nav-link {
  padding: 0.4rem 0.85rem;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 500;
  color: rgba(255,255,255,.7);
  transition: var(--transition-fast);
}

.nav-link:hover,
.nav-link.active {
  color: var(--white);
  background: rgba(255,255,255,.1);
}

.nav-cta {
  flex-shrink: 0;
}

/* Hamburger */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  margin-left: auto;
}

.hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: var(--transition-fast);
}

.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Mobile menu */
.mobile-menu {
  display: none;
  flex-direction: column;
  background: rgba(15, 23, 42, 0.98);
  border-top: 1px solid rgba(255,255,255,.06);
  padding: 0.75rem 1.5rem 1.25rem;
}

.mobile-menu.open { display: flex; }

.mobile-link {
  padding: 0.7rem 0;
  font-size: 0.95rem;
  font-weight: 500;
  color: rgba(255,255,255,.8);
  border-bottom: 1px solid rgba(255,255,255,.06);
  transition: color 0.2s;
}

.mobile-link:hover { color: var(--white); }

/* ============================================================
   6. BUTTONS
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.65rem 1.5rem;
  border-radius: var(--radius-full);
  font-family: 'Poppins', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: var(--transition);
  white-space: nowrap;
  letter-spacing: 0.01em;
}

.btn-primary {
  background: var(--gradient-primary);
  color: var(--white);
  box-shadow: 0 4px 15px rgba(37,99,235,.35);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(37,99,235,.45);
}

.btn-primary:active { transform: translateY(0); }

.btn-outline {
  background: transparent;
  color: var(--white);
  border: 2px solid rgba(255,255,255,.35);
}

.btn-outline:hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.6);
  transform: translateY(-2px);
}

.btn-lg {
  padding: 0.85rem 2rem;
  font-size: 0.95rem;
}

.btn-block {
  width: 100%;
  border-radius: var(--radius-md);
  padding: 0.9rem;
  font-size: 1rem;
}

/* ============================================================
   7. HERO SECTION
   ============================================================ */
.hero {
  min-height: 100vh;
  background: var(--gradient-hero);
  display: flex;
  align-items: center;
  padding: 100px 0 60px;
  position: relative;
  overflow: hidden;
}

/* Decorative background dots */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(circle at 20% 50%, rgba(37,99,235,.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(124,58,237,.15) 0%, transparent 40%);
  pointer-events: none;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* --- Hero Text --- */
.hero-badge {
  display: inline-block;
  background: rgba(255,255,255,.1);
  border: 1px solid rgba(255,255,255,.2);
  color: var(--blue-400);
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.35rem 1rem;
  border-radius: var(--radius-full);
  margin-bottom: 1.25rem;
  letter-spacing: 0.03em;
}

.hero-title {
  font-size: clamp(2rem, 5vw, 3.25rem);
  font-weight: 800;
  color: var(--white);
  line-height: 1.15;
  margin-bottom: 1.25rem;
}

.hero-desc {
  font-size: 1.05rem;
  color: rgba(255,255,255,.72);
  max-width: 500px;
  margin-bottom: 2rem;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  margin-bottom: 2.5rem;
}

/* Stats row */
.hero-stats {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-item strong {
  color: var(--white);
  font-size: 1.1rem;
  font-weight: 700;
}

.stat-item span {
  color: rgba(255,255,255,.55);
  font-size: 0.75rem;
}

.stat-divider {
  width: 1px;
  height: 36px;
  background: rgba(255,255,255,.15);
}

/* --- Hero Visual (right) --- */
.hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 420px;
}

.hero-blob {
  position: relative;
  width: 340px;
  height: 340px;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: blobPulse 6s ease-in-out infinite;
}

@keyframes blobPulse {
  0%, 100% { transform: scale(1); }
  50%       { transform: scale(1.04); }
}

.student-illustration {
  position: absolute;
  bottom: -10px;
}

/* Floating info cards */
.hero-card-float {
  position: absolute;
  background: rgba(255,255,255,.12);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.2);
  color: var(--white);
  font-size: 0.78rem;
  font-weight: 600;
  padding: 0.5rem 0.9rem;
  border-radius: var(--radius-md);
  white-space: nowrap;
  box-shadow: var(--shadow-md);
}

.card-1 { top: 10%;  left:  -10%; animation: floatCard 3s ease-in-out infinite; }
.card-2 { top: 45%;  right: -12%; animation: floatCard 3s ease-in-out infinite 1s; }
.card-3 { bottom: 8%; left: 5%;   animation: floatCard 3s ease-in-out infinite 2s; }

@keyframes floatCard {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-8px); }
}

/* Scroll indicator */
.scroll-indicator {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scroll-dot {
  width: 6px;
  height: 6px;
  background: rgba(255,255,255,.5);
  border-radius: 50%;
  animation: scrollBounce 1.8s ease-in-out infinite;
}

@keyframes scrollBounce {
  0%, 100% { transform: translateY(0); opacity: 1; }
  50%       { transform: translateY(10px); opacity: 0.4; }
}

/* ============================================================
   8. SECTION SHARED
   ============================================================ */
.section {
  padding: 5rem 0;
}

.section-alt {
  background: var(--gradient-soft);
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-badge {
  display: inline-block;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

.section-title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 800;
  color: var(--navy-800);
  margin-bottom: 0.75rem;
}

.section-desc {
  color: var(--gray-500);
  max-width: 560px;
  margin: 0 auto;
  font-size: 0.95rem;
}

/* ============================================================
   9. FEATURE CARDS
   ============================================================ */
.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.feature-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 2rem 1.5rem;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-100);
  transition: var(--transition);
  cursor: default;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.feature-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-xl);
  border-color: var(--blue-100);
}

.feature-icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
}

.icon-blue   { background: var(--blue-50);   }
.icon-purple { background: var(--purple-100); }
.icon-teal   { background: #f0fdfa;           }
.icon-orange { background: #fff7ed;           }

.feature-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy-800);
}

.feature-card p {
  font-size: 0.875rem;
  color: var(--gray-500);
  line-height: 1.7;
  flex: 1;
}

.card-link {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--blue-600);
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  transition: gap 0.2s;
}

.card-link:hover { gap: 0.6rem; }

.card-link span { transition: transform 0.2s; }
.card-link:hover span { transform: translateX(3px); }

/* ============================================================
  10. SCHEDULE TABLE
   ============================================================ */
.table-wrapper {
  overflow-x: auto;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.schedule-table {
  width: 100%;
  border-collapse: collapse;
  background: var(--white);
  font-size: 0.9rem;
  min-width: 640px;
}

.schedule-table thead tr {
  background: var(--gradient-primary);
  color: var(--white);
}

.schedule-table th {
  padding: 1rem 1.25rem;
  text-align: left;
  font-weight: 600;
  font-size: 0.85rem;
  letter-spacing: 0.03em;
}

.schedule-table td {
  padding: 0.95rem 1.25rem;
  border-bottom: 1px solid var(--gray-100);
  color: var(--navy-700);
}

.schedule-table tbody tr {
  transition: background 0.15s;
}

.schedule-table tbody tr:hover {
  background: var(--blue-50);
}

.schedule-table tbody tr:last-child td {
  border-bottom: none;
}

.today-row td { background: #eff6ff; }
.today-row:hover td { background: #dbeafe !important; }

/* Day badges */
.day-badge {
  display: inline-block;
  padding: 0.2rem 0.7rem;
  border-radius: var(--radius-full);
  font-size: 0.78rem;
  font-weight: 600;
}

.monday    { background: #dbeafe; color: #1d4ed8; }
.tuesday   { background: var(--purple-100); color: #6d28d9; }
.wednesday { background: #d1fae5; color: #065f46; }
.thursday  { background: #fef3c7; color: #92400e; }
.friday    { background: #fee2e2; color: #991b1b; }

/* ============================================================
  11. TASK LIST (TUGAS)
   ============================================================ */
.tugas-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.75rem;
  justify-content: center;
}

.filter-pill {
  padding: 0.4rem 1.1rem;
  border-radius: var(--radius-full);
  font-family: 'Poppins', sans-serif;
  font-size: 0.82rem;
  font-weight: 500;
  border: 2px solid var(--gray-200);
  background: var(--white);
  color: var(--gray-500);
  cursor: pointer;
  transition: var(--transition-fast);
}

.filter-pill:hover {
  border-color: var(--blue-500);
  color: var(--blue-600);
}

.filter-pill.active {
  background: var(--gradient-primary);
  border-color: transparent;
  color: var(--white);
  box-shadow: 0 4px 12px rgba(37,99,235,.3);
}

.tugas-list {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.tugas-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 1.1rem 1.35rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-100);
  gap: 1rem;
  transition: var(--transition);
}

.tugas-card:hover {
  transform: translateX(4px);
  box-shadow: var(--shadow-md);
  border-color: var(--blue-100);
}

.tugas-card[data-status="selesai"] {
  opacity: 0.75;
}

.tugas-left {
  display: flex;
  align-items: center;
  gap: 1rem;
  min-width: 0;
}

.tugas-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.tugas-left h4 {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--navy-800);
  margin-bottom: 0.2rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 400px;
}

.tugas-meta {
  font-size: 0.78rem;
  color: var(--gray-400);
}

/* Badges */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.85rem;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-belum  { background: var(--red-100);    color: #991b1b; }
.badge-proses { background: var(--yellow-100); color: #92400e; }
.badge-selesai { background: var(--green-100); color: #065f46; }

/* ============================================================
  12. TIPS CARDS
   ============================================================ */
.tips-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}

.tips-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 2rem 1.5rem;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-100);
  position: relative;
  overflow: hidden;
  transition: var(--transition);
}

.tips-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.tips-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: var(--gradient-primary);
}

.tips-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--gray-100);
  line-height: 1;
  margin-bottom: 0.5rem;
  font-variant-numeric: tabular-nums;
}

.tips-emoji {
  font-size: 1.75rem;
  margin-bottom: 0.75rem;
}

.tips-card h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--navy-800);
  margin-bottom: 0.6rem;
}

.tips-card p {
  font-size: 0.875rem;
  color: var(--gray-500);
  line-height: 1.7;
}

/* ============================================================
  13. ABOUT SECTION
   ============================================================ */
.about-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.about-img-wrap {
  position: relative;
  width: 100%;
  max-width: 380px;
  margin: 0 auto;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.about-blob {
  width: 100%;
  height: 100%;
  border-radius: 60% 40% 50% 50% / 50% 60% 40% 50%;
  background: var(--gradient-primary);
  opacity: 0.12;
  animation: blobPulse 6s ease-in-out infinite;
}

.about-icon-grid {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 1rem;
  padding: 1.5rem;
}

.aig-item {
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  transition: var(--transition);
}

.aig-item:hover {
  transform: scale(1.1);
  box-shadow: var(--shadow-lg);
}

.about-text p {
  color: var(--gray-600);
  line-height: 1.8;
  font-size: 0.95rem;
}

.about-list {
  margin-top: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.about-list li {
  font-size: 0.9rem;
  color: var(--navy-700);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* ============================================================
  14. CONTACT SECTION
   ============================================================ */
.contact-wrapper {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 3rem;
  align-items: start;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact-info-card {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  background: var(--white);
  border-radius: var(--radius-md);
  padding: 1.1rem 1.25rem;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-100);
  transition: var(--transition);
}

.contact-info-card:hover {
  transform: translateX(4px);
  box-shadow: var(--shadow-md);
}

.ci-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.contact-info-card strong {
  display: block;
  font-size: 0.88rem;
  color: var(--navy-800);
  margin-bottom: 0.15rem;
}

.contact-info-card p {
  font-size: 0.82rem;
  color: var(--gray-500);
}

/* Form */
.contact-form {
  background: var(--white);
  border-radius: var(--radius-lg);
  padding: 2rem;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--gray-100);
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.form-group label {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--navy-700);
}

.form-group input,
.form-group textarea {
  font-family: 'Poppins', sans-serif;
  font-size: 0.875rem;
  padding: 0.7rem 1rem;
  border: 2px solid var(--gray-200);
  border-radius: var(--radius-md);
  color: var(--navy-800);
  background: var(--gray-50);
  transition: var(--transition-fast);
  outline: none;
  resize: none;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--blue-500);
  background: var(--white);
  box-shadow: 0 0 0 3px rgba(59,130,246,.12);
}

/* Error state */
.form-group input.error,
.form-group textarea.error {
  border-color: var(--red-500);
  background: #fff5f5;
}

.field-error {
  font-size: 0.78rem;
  color: var(--red-500);
  min-height: 1rem;
}

.form-success {
  background: var(--green-100);
  color: #065f46;
  border-radius: var(--radius-md);
  padding: 0.85rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  text-align: center;
  border: 1px solid #bbf7d0;
}

/* ============================================================
  15. FOOTER
   ============================================================ */
.footer {
  background: var(--navy);
  color: rgba(255,255,255,.7);
  padding-top: 4rem;
}

.footer-inner {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 3rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.footer-logo {
  color: var(--white) !important;
  margin-bottom: 0.75rem;
}

.footer-brand p {
  font-size: 0.875rem;
  line-height: 1.7;
  max-width: 300px;
  margin-bottom: 1.25rem;
}

.footer-socials {
  display: flex;
  gap: 0.75rem;
}

.social-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255,255,255,.15);
  font-size: 0.8rem;
  color: rgba(255,255,255,.75);
  transition: var(--transition-fast);
}

.social-btn:hover {
  background: rgba(255,255,255,.1);
  color: var(--white);
  border-color: rgba(255,255,255,.35);
}

.footer-links-group h4 {
  color: var(--white);
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 1rem;
}

.footer-links-group ul {
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.footer-links-group a {
  font-size: 0.85rem;
  color: rgba(255,255,255,.6);
  transition: color 0.2s;
}

.footer-links-group a:hover { color: var(--white); }

.footer-bottom {
  text-align: center;
  padding: 1.25rem 0;
  font-size: 0.82rem;
  color: rgba(255,255,255,.4);
}

/* ============================================================
  16. BACK TO TOP
   ============================================================ */
.back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  z-index: 900;
  width: 44px;
  height: 44px;
  background: var(--gradient-primary);
  color: var(--white);
  border: none;
  border-radius: 50%;
  font-size: 1.1rem;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  opacity: 0;
  transform: translateY(16px);
  transition: var(--transition);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-to-top.visible {
  opacity: 1;
  transform: translateY(0);
}

.back-to-top:hover { transform: translateY(-3px); }

/* ============================================================
  17. ANIMATIONS & REVEAL
   ============================================================ */

/* Page-load fade in for body */
body {
  animation: bodyFadeIn 0.5s ease forwards;
}

@keyframes bodyFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* Reveal on scroll */
.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.reveal.reveal-right {
  transform: translateX(30px);
}

.reveal.visible {
  opacity: 1;
  transform: translate(0, 0);
}

/* Stagger delays via data-delay attribute */
.reveal[data-delay="100"] { transition-delay: 0.1s; }
.reveal[data-delay="200"] { transition-delay: 0.2s; }
.reveal[data-delay="300"] { transition-delay: 0.3s; }

/* ============================================================
  18. RESPONSIVE
   ============================================================ */
@media (max-width: 1024px) {
  .features-grid { grid-template-columns: repeat(2, 1fr); }
  .tips-grid      { grid-template-columns: repeat(2, 1fr); }
  .about-wrapper  { grid-template-columns: 1fr; gap: 2rem; }
  .about-visual   { display: none; }
  .contact-wrapper { grid-template-columns: 1fr; }
  .contact-info { display: grid; grid-template-columns: repeat(2, 1fr); }
  .footer-inner { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 768px) {
  /* Navbar */
  .nav-links, .nav-cta { display: none; }
  .hamburger { display: flex; }

  /* Hero */
  .hero-inner {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero-visual { display: none; }
  .hero-desc   { margin: 0 auto 2rem; }
  .hero-actions { justify-content: center; }
  .hero-stats   { justify-content: center; }

  /* Features */
  .features-grid { grid-template-columns: 1fr; }
  .tips-grid      { grid-template-columns: 1fr; }

  /* Contact */
  .form-row { grid-template-columns: 1fr; }
  .contact-info { grid-template-columns: 1fr; }

  /* Footer */
  .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
}

@media (max-width: 480px) {
  .section { padding: 3.5rem 0; }
  .hero { padding: 90px 0 50px; }
  .btn-lg { padding: 0.75rem 1.4rem; font-size: 0.9rem; }
  .tugas-left h4 { max-width: 220px; }
}
